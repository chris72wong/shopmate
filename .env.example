# Primary AI meal-to-grocery workflow. Never use a NEXT_PUBLIC_ prefix.
# Model: gemini-3.5-flash-lite. Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Optional nearby-grocer discovery. AI meals do not require retailer prices.
# Explicit legacy demo mode requires no credentials. Provider secrets are server-only.
# Enable Geocoding API and Places API (New) with billing and API restrictions.
# Never rename this with a NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_API_KEY=

# Application-owned ReefAPI key, obtained at https://reefapi.com/signup.
# Enables the implemented Loblaws-family CA and Kroger-family US pricing adapters.
# No live mappings are shipped: review exact branches/SKUs before configuring.
# See docs/PRICING.md for schemas, examples and credential/coverage limitations.
REEF_KEY=
SHOPMATE_PRICING_STORES=[]
SHOPMATE_PRICING_PRODUCTS=[]

# Official Kroger Public Products/Locations adapter (US in-store), also used by the probe.
# Obtain OAuth client credentials with product.compact scope at developer.kroger.com.
# Exact branch mapping can resolve automatically from Google address/banner agreement.
# Reviewed SHOPMATE_PRICING_PRODUCTS rows with providerId "kroger" are still required.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional ZIP for the standalone opt-in access probe only.
KROGER_PROBE_POSTAL_CODE=

# Optional browser-safe Brandfetch Logo API client ID (NOT a secret Brand API key).
# Get your own free ID at https://developers.brandfetch.com/ and rebuild/restart.
# Without this, retailer cards use local initials; demo stores always use fictional icons.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
